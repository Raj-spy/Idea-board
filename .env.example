# PostgreSQL connection settings used by the backend.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ideaboard
POSTGRES_USER=ideaboard
POSTGRES_PASSWORD=change-me

# Comma-separated browser origins allowed by the backend.
CORS_ORIGINS=http://localhost:5173

# Frontend API URL. Leave empty to use the Vite development proxy.
VITE_API_BASE_URL=
